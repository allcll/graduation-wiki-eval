{
  "name": "graduation-wiki-eval",
  "version": "0.4.0",
  "private": true,
  "description": "Evaluate graduation-policy answers and compare WIKI and Skill revisions.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "grad-eval": "dist/cli.js",
    "grad-eval-claude": "dist/adapters/claude.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "sample",
    "README.md",
    "docs",
    "datasets/**/*.md",
    "datasets/**/*.json",
    "datasets/**/*.jsonl"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/build-review-ui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "check:package": "node scripts/check-package.mjs",
    "dev": "node --import tsx src/cli.ts",
    "demo": "npm run build && node dist/cli.js demo",
    "prepack": "npm run build",
    "check:dataset": "node dist/cli.js dataset-check --root . --manifest datasets/graduation-2026-2/v1/manifest.json --metadata-only"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/allcll/graduation-wiki-eval.git"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
